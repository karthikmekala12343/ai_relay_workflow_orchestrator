          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Run detail returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create looping step-cap draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman max-steps demo\",\n  \"maxSteps\": 2,\n  \"nodes\": [\n    {\n      \"id\": \"loop\",\n      \"type\": \"condition\",\n      \"label\": \"Always loop\",\n      \"args\": {\n        \"left\": true,\n        \"operator\": \"truthy\",\n        \"onTrueNodeId\": \"loop\",\n        \"onFalseNodeId\": \"finish\"\n      }\n    },\n    {\n      \"id\": \"finish\",\n      \"type\": \"notify\",\n      \"label\": \"Unreachable finish\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/workflows"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Step-cap workflow created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('stepCapWorkflowId', pm.response.json().workflow.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish step-cap workflow",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/workflows/{{stepCapWorkflowId}}/publish"
          }
        },
        {
          "name": "Run step-cap workflow",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/workflows/{{stepCapWorkflowId}}/run"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Step-cap run queued', function () {",
                  "  pm.response.to.have.status(202);",
                  "  pm.collectionVariables.set('stepCapRunId', pm.response.json().run.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Inspect step-cap run (expect FAILED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/runs/{{stepCapRunId}}",
            "description": "Repeat until FAILED; inspect the step_limit_exceeded trace."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
